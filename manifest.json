{
  "manifest_version": 3,
  "name": "B站氛围光 · Ambient Light for Bilibili",
  "short_name": "B站氛围光",
  "version": "1.0.3",
  "description": "在 B 站看视频时，让视频画面的色彩溢出到整个网页，营造沉浸式氛围光效果。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "B站氛围光",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/*"],
      "js": ["src/settings.js", "src/ambient.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/noise.png"],
      "matches": ["https://www.bilibili.com/*"]
    }
  ],
  "permissions": ["storage"]
}
